apps_dir: apps
www_root: wwwroot
database_dsn: "postgres://postgres:password@localhost:5432/aigen?sslmode=disable"
domain: localhost
port: "5000"
agentic_config_path: agentic.yaml

storage:
  driver: fs
  fs:
    root: wwwroot/files
    url_prefix: /files

channels:
  a2a_enabled: true
  whatsapp:
    enabled: true
    gateway_url: "http://localhost:8080"
    gateway_number: "+1234567890"

mcp:
  enabled: true
  api_keys:
    - key: "test-mcp-key"
      user_id: 1

temporary_access:
  - path: "tmp"
    ttl: 300
    role: "admin"
