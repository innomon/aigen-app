{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Query",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "title": "Query Name",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "title": "GraphQL Query",
      "format": "textarea"
    }
  }
}
