{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page",
  "type": "object",
  "required": ["name", "title"],
  "properties": {
    "name": {
      "type": "string",
      "title": "Page Name",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "title": "Page Title",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "title": "Query"
    },
    "html": {
      "type": "string",
      "title": "HTML Content",
      "format": "textarea"
    },
    "css": {
      "type": "string",
      "title": "CSS",
      "format": "textarea"
    }
  }
}
